<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>IdeaFlow | Decentralized Innovation</title>

    <!-- This line connects the CSS file. It must match the exact filename -->
    <link rel="stylesheet" href="style.css">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Include Marked.js to parse the markdown challenges -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <style>
        /* Soft flushy pink background */
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background:
                radial-gradient(circle at 10% 20%, rgba(255, 120, 190, 0.45), transparent 30%),
                radial-gradient(circle at 90% 10%, rgba(255, 180, 220, 0.4), transparent 30%),
                radial-gradient(circle at 50% 90%, rgba(255, 90, 170, 0.35), transparent 35%),
                linear-gradient(135deg, #fff0f7, #ffd6eb, #ffc1df);

            color: #3b1830;
            min-height: 100vh;
        }

        /* Header */
        .header {
            padding-top: 2rem;
            padding-bottom: 2rem;
        }

        .logo-group h1 {
            color: #9e2f6d;
        }

        /* Main cards */
        .card {
            background: rgba(255, 255, 255, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(170, 60, 120, 0.15);
            backdrop-filter: blur(12px);
        }

        /* Hero */
        .hero {
            background: rgba(255, 255, 255, 0.55);
        }

        .hero h2 {
            color: #8f245f;
        }

        /* Pink primary buttons */
        .btn-primary {
            background: linear-gradient(135deg, #e83e91, #c92f78);
            color: white;
            border: none;
            box-shadow: 0 6px 18px rgba(201, 47, 120, 0.25);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #f052a0, #d93682);
            transform: translateY(-2px);
        }

        /* Outline buttons */
        .btn-outline {
            background: rgba(255, 255, 255, 0.5);
            color: #a12d6c;
            border: 1px solid #e58ab8;
        }

        .btn-outline:hover {
            background: #f8b1d2;
            color: #6d1749;
        }

        /* Inputs */
        input,
        textarea {
            background: rgba(255, 255, 255, 0.7);
            color: #421b34;
            border: 1px solid #e5a0c2;
            border-radius: 10px;
        }

        input:focus,
        textarea:focus {
            outline: none;
            border-color: #df4f94;
            box-shadow: 0 0 0 3px rgba(223, 79, 148, 0.15);
        }

        /* Labels */
        label {
            color: #6d234c;
        }

        /* Muted text */
        .muted {
            color: #7e536d;
        }

        /* Challenge section */
        .challenge-content {
            background: rgba(255, 255, 255, 0.35);
            border-radius: 12px;
        }

        /* Footer */
        .footer {
            color: #7e536d;
            padding-top: 2rem;
            padding-bottom: 2rem;
        }
    </style>
</head>

<body>

    <header class="container header">
        <div class="logo-group">
            <h1>IdeaFlow</h1>
            <p class="muted">A decentralized platform for community-driven ideas.</p>
        </div>

        <button id="connectWalletBtn" class="btn btn-primary">
            Connect Wallet
        </button>
    </header>


    <main class="container">

        <section class="hero card">
            <h2>Ideas, owned by the community.</h2>

            <p>
                Submit and vote on ideas through a blockchain smart contract deployed on Sepolia.
            </p>
        </section>


        <!-- Workshop Challenges Section -->
        <section class="card">

            <h3>Workshop Challenges</h3>

            <p class="muted" style="margin-bottom: 1rem; font-size: 0.875rem;">
                Progress through the tasks to upgrade your dApp.
            </p>

            <div class="challenge-tabs" id="challengeTabs">

                <button class="btn btn-outline" data-file="README.md">
                    Intro
                </button>

                <button class="btn btn-outline" data-file="level-1.md">
                    Level 1
                </button>

                <button class="btn btn-outline" data-file="level-2.md">
                    Level 2
                </button>

                <button class="btn btn-outline" data-file="level-3.md">
                    Level 3
                </button>

                <button class="btn btn-outline" data-file="level-4.md">
                    Level 4
                </button>

            </div>

            <div id="challengeContent" class="challenge-content">

                <p class="muted">
                    Select a challenge level above to view instructions.
                </p>

            </div>

        </section>


        <section class="card connection-grid">

            <div>

                <label for="contractAddress">
                    Contract Address
                </label>

                <input
                    id="contractAddress"
                    type="text"
                    placeholder="0x... your deployed IdeaFlow contract"
                >

            </div>


            <button id="connectContractBtn" class="btn btn-primary">
                Connect Contract
            </button>


            <div class="status-stack">

                <p id="networkStatus" class="status muted">
                    Network: Not connected
                </p>

                <p id="walletStatus" class="status muted">
                    Wallet: Connect your wallet to continue.
                </p>

                <p id="contractStatus" class="status muted">
                    Contract: Enter your deployed IdeaFlow contract address.
                </p>

            </div>

        </section>


        <section class="card">

            <h3>Create Idea</h3>

            <form id="ideaForm" class="form-grid">

                <div>

                    <label for="ideaTitle">
                        Title
                    </label>

                    <input
                        id="ideaTitle"
                        type="text"
                        maxlength="120"
                        required
                    >

                </div>


                <div>

                    <label for="ideaDescription">
                        Description
                    </label>

                    <textarea
                        id="ideaDescription"
                        rows="4"
                        maxlength="500"
                        required
                    ></textarea>

                </div>


                <button type="submit" class="btn btn-primary">
                    Submit Idea
                </button>

            </form>

            <p id="txStatus" class="status muted"></p>

        </section>


        <section class="card">

            <div class="ideas-header">

                <h3>Ideas</h3>

                <button id="refreshIdeasBtn" class="btn btn-outline">
                    Refresh
                </button>

            </div>


            <div id="ideasList" class="ideas-list">

                <p class="muted">
                    Connect your wallet and contract to load ideas.
                </p>

            </div>

        </section>

    </main>


    <footer class="container footer muted">

        <p>
            Built for the decentralized community
        </p>

        <p>
            Sepolia testnet only. Do not use real funds.
        </p>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/ethers@6.13.2/dist/ethers.umd.min.js"></script>

    <script src="abi.js"></script>

    <script src="config.js"></script>

    <script src="app.js"></script>

</body>

</html>
       
  
